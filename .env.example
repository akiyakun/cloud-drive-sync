# docker-compose.yaml が使う場所の設定。このファイルを .env という名前でコピーして使う（.env は git に入れない）
#   cp .env.example .env
# 書くのは「Docker が動いているマシンの中の場所」。NAS なら NAS の中の場所（/volume3/...）。

# 鍵（token.json）の置き場所。SSH でしか入れない、このアプリ専用（UID/GID 28103）のフォルダ
CDS_SECRETS_DIR=/volume3/.secrets/cloud-drive-sync

# 設定・同期の記録・退避の置き場所（中に config.toml を置く）
CDS_DATA_DIR=./data

# コンテナが作るファイルのグループ（番号）。このグループのメンバーも、作られたファイルを書き換え・削除できる
# NAS で `id` を実行して出てくる、自分が入っているグループ（例: users = 100）にする
CDS_GID=100

# 出力の土台（AI が読む場所）。data/config.toml の各同期先の output は、ここから見た場所になる
CDS_OUTPUT_DIR=/volume3/ndrive/CloudDrive
